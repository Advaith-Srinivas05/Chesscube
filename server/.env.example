PORT=3001
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/chess for a local database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chess

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3000

# Long random string (at least 32 bytes) used to sign session tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google Identity Services OAuth client id (needed for Google sign-in)
GOOGLE_CLIENT_ID=

# Email (sign-up, reset and email-change codes). Pick one; with neither, development logs emails to the console.
# 1) Google Apps Script web app over HTTPS - use this in production (free hosts block SMTP ports). See README "Email".
MAIL_SCRIPT_URL=
MAIL_SCRIPT_SECRET=
# 2) SMTP with a Gmail app password - fine locally.
SMTP_USER=
SMTP_PASS=
# Emails sent per UTC day before the API refuses more (default 90; Apps Script allows about 100 recipients a day).
MAIL_DAILY_LIMIT=

# Shared with Vercel (client/middleware.js), which forwards each visitor's IP signed with it. Required in production.
# Generate like JWT_SECRET. Locally it can stay empty.
PROXY_SECRET=
# X-Forwarded-For entries the host's proxies append, for connections straight to the API (default 1 in production).
PROXY_HOPS=
