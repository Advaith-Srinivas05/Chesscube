PORT=3001
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/chess for a local database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chess

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3000

# Long random string (at least 32 bytes) used to sign session tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google Identity Services OAuth client id (needed for Google sign-in)
GOOGLE_CLIENT_ID=

# Gmail address and app password used to send email.
# Optional in development (emails are logged to the console); required when NODE_ENV=production.
SMTP_USER=
SMTP_PASS=
