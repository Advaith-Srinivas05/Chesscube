    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "nodemailer": "^10.0.9",
    "socket.io": "^4.8.3",
    "zod": "^4.6.4"
